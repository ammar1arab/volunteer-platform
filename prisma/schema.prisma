generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VOLUNTEER
}

enum Gender {
  MALE
  FEMALE
}

enum JordanianCity {
  AMMAN
  ZARQA
  IRBID
  AQABA
  SALT
  MAFRAQ
  KARAK
  MADABA
  JERASH
  AJLOUN
  TAFILAH
  MAAN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdActivities Activity[]              @relation("ActivityCreator")
  participations    ActivityParticipation[] @relation("VolunteerParticipations")
  volunteerProfile  VolunteerProfile?

  @@map("users")
}

model VolunteerProfile {
  id                     String        @id @default(uuid())
  userId                 String        @unique
  city                   JordanianCity
  dateOfBirth            DateTime
  profilePictureUrl      String?
  gender                 Gender?
  bio                    String?
  skills                 String[]      @default([])
  interests              String[]      @default([])
  hasVolunteerExperience Boolean       @default(false)
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("volunteer_profiles")
}

model Activity {
  id                String   @id @default(uuid())
  title             String
  description       String
  imageUrl          String
  dayOfWeek         String
  date              DateTime
  startTime         String
  endTime           String
  placeName         String
  latitude          Float
  longitude         Float
  address           String
  targetAudience    String
  maxVolunteers     Int
  currentVolunteers Int      @default(0)
  status            String   @default("DRAFT")
  createdBy         String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator        User                    @relation("ActivityCreator", fields: [createdBy], references: [id])
  participations ActivityParticipation[]

  @@index([status, date])
  @@index([createdBy])
  @@map("activities")
}

model ActivityParticipation {
  id          String    @id @default(uuid())
  activityId  String
  volunteerId String
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  respondedAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  volunteer User     @relation("VolunteerParticipations", fields: [volunteerId], references: [id])

  @@unique([activityId, volunteerId])
  @@index([activityId])
  @@index([volunteerId])
  @@index([status])
  @@map("activity_participations")
}

model FeaturedPost {
  id          String   @id @default(uuid())
  imageUrl    String
  title       String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@map("featured_posts")
}
