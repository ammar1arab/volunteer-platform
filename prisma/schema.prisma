generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    ADMIN
    VOLUNTEER
}

model User {
    id        String   @id @default(uuid())
    email     String   @unique
    password  String
    fullName  String
    phone     String
    role      UserRole
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
    @@index([email])
}