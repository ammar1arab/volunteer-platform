generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                  @id @default(uuid())
  email             String                  @unique
  password          String
  fullName          String
  phone             String
  role              UserRole
  emailVerified     Boolean                 @default(false)
  tokenVersion      Int                     @default(0)
  isSuperAdmin      Boolean                 @default(false)
  permissions       String[]                @default([])
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  createdActivities Activity[]              @relation("ActivityCreator")
  participations    ActivityParticipation[] @relation("VolunteerParticipations")
  volunteerProfile  VolunteerProfile?
  certificates      Certificate[]
  notifications     Notification[]

  @@map("users")
}

model VolunteerProfile {
  id                     String        @id @default(uuid())
  userId                 String        @unique
  city                   JordanianCity
  dateOfBirth            DateTime
  profilePictureUrl      String?
  gender                 Gender?
  bio                    String?
  skills                 String[]      @default([])
  interests              String[]      @default([])
  hasVolunteerExperience Boolean       @default(false)
  totalVolunteerHours    Float         @default(0)
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("volunteer_profiles")
}

model Activity {
  id                String                  @id @default(uuid())
  title             String
  description       String
  imageUrl          String
  dayOfWeek         String
  date              DateTime
  startTime         String
  endTime           String
  durationHours     Float                   @default(0)
  placeName         String?
  city              String?
  latitude          Float?
  longitude         Float?
  meetingLink       String?
  meetingPlatform   String?
  externalMeetingId String?
  maxVolunteers     Int
  currentVolunteers Int                     @default(0)
  deletedAt         DateTime?
  status            String                  @default("DRAFT")
  activityType      String                  @default("IN_PERSON")
  categories        String[]                @default([])
  createdBy         String
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  creator           User                    @relation("ActivityCreator", fields: [createdBy], references: [id])
  participations    ActivityParticipation[]
  certificates      Certificate[]

  @@index([status, date])
  @@index([createdBy])
  @@map("activities")
}

model ActivityParticipation {
  id               String    @id @default(uuid())
  activityId       String
  volunteerId      String
  status           String    @default("PENDING")
  requestedAt      DateTime  @default(now())
  respondedAt      DateTime?
  attendanceStatus String    @default("NOT_MARKED")
  volunteerHours   Float?
  markedAt         DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  activity         Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  volunteer        User      @relation("VolunteerParticipations", fields: [volunteerId], references: [id])

  @@unique([activityId, volunteerId])
  @@index([activityId])
  @@index([volunteerId])
  @@index([status])
  @@map("activity_participations")
}

model Certificate {
  id         String            @id @default(uuid())
  userId     String
  activityId String
  pngUrl     String?
  status     CertificateStatus @default(GENERATING)
  issuedAt   DateTime          @default(now())
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId])
  @@map("certificates")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model FeaturedPost {
  id          String                 @id @default(uuid())
  imageUrl    String
  title       String
  description String                 @db.Text
  publishedAt DateTime               @default(now())
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  categories  FeaturedPostCategory[] @default([])

  @@index([title])
  @@map("featured_posts")
}

model VolunteerSpotlight {
  id            String        @id @default(uuid())
  imageUrl      String
  name          String
  description   String        @db.Text
  spotlightDate DateTime
  city          JordanianCity
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([name])
}

model MonthlyMagazine {
  id        String   @id @default(uuid())
  title     String
  pdfUrl    String
  monthYear DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monthYear])
  @@map("monthly_magazines")
}

model OtpCode {
  id        String    @id @default(uuid())
  email     String
  code      String
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, type])
  @@map("otp_codes")
}

enum UserRole {
  ADMIN
  VOLUNTEER
}

enum OtpType {
  EMAIL_VERIFY
  FORGOT_PASSWORD
}

enum Gender {
  MALE
  FEMALE
}

enum CertificateStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum NotificationType {
  CERTIFICATE_ISSUED
  ANNOUNCEMENT
}

enum JordanianCity {
  AMMAN
  ZARQA
  IRBID
  AQABA
  SALT
  MAFRAQ
  KARAK
  MADABA
  JERASH
  AJLOUN
  TAFILAH
  MAAN
  OUTOFJORDAN
}

enum FeaturedPostCategory {
  HEALTH
  EDUCATION
  TECHNOLOGY
  ENVIRONMENT
  ENTREPRENEURSHIP
  SELF_DEVELOPMENT
  ARTS
  SPORTS
  ENTERTAINMENT
  DISABILITY
  ECONOMY
  LAW
  CULTURE
  SPECIAL_EVENTS
}
